<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:theme="@style/Theme.Dashboard"
    >

    <LinearLayout
        android:id="@+id/time_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/rewind"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/rewind_button"
            android:contentDescription="rewind" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/pause"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/pause"
            android:contentDescription="pause" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/fast_forward"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/fast_forward"
            android:backgroundTint="@null"
            android:contentDescription="ff" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Skip Time: "
             />

        <EditText
            android:id="@+id/skip_time_input"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:background="@drawable/input_style"
            android:gravity="center"
            android:inputType="numberDecimal"
            android:text="5"
            android:textColor="@color/white"
             />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/loop_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/progress_section"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/time_controls">

        <TextView
            android:id="@+id/tvCurrentText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/current_loop_null_value" />

        <Button
            android:id="@+id/loop_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/generic_button"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="Start Loop" />

        <Button
            android:id="@+id/clear_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/generic_button"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:text="CLR" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/progress_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/loop_controls"
        android:layout_marginTop="50dp"
        app:layout_constraintBottom_toTopOf="@id/beats_section">

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@android:style/Widget.ProgressBar.Horizontal"

            android:progress="0"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/beats_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/progress_section"
        app:layout_constraintBottom_toBottomOf="parent"
        >



    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>